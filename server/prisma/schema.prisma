generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_URL")
}

model User {
  id                String              @id @default(uuid()) @db.Char(36)
  email             String              @unique @db.VarChar(320)
  passwordHash      String              @map("password_hash") @db.VarChar(255)
  emailVerifiedAt   DateTime?           @map("email_verified_at")
  status            UserStatus           @default(PENDING)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  lists             TaskList[]
  operations        SyncOperation[]
  refreshTokens     RefreshToken[]
  emailVerifications EmailVerification[]

  @@map("users")
}

model TaskList {
  id        String    @id @default(uuid()) @db.Char(36)
  ownerId   String    @map("owner_id") @db.Char(36)
  name      String    @db.VarChar(120)
  color     String?   @db.VarChar(20)
  sortOrder Decimal   @default(0) @map("sort_order") @db.Decimal(20, 6)
  archivedAt DateTime? @map("archived_at")
  deletedAt DateTime?  @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  version   Int       @default(1)
  owner     User      @relation(fields: [ownerId], references: [id])
  tasks     Task[]

  @@index([ownerId, deletedAt])
  @@map("task_lists")
}

model Task {
  id             String    @id @default(uuid()) @db.Char(36)
  listId         String    @map("list_id") @db.Char(36)
  creatorId      String    @map("creator_id") @db.Char(36)
  parentTaskId   String?   @map("parent_task_id") @db.Char(36)
  title          String    @db.VarChar(500)
  note           String?   @db.Text
  status         TaskStatus @default(PENDING)
  priority       Int       @default(0)
  dueAt          DateTime? @map("due_at")
  sortKey        Decimal   @default(0) @map("sort_key") @db.Decimal(20, 6)
  tags           Json?
  completedAt    DateTime? @map("completed_at")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  version        Int       @default(1)
  fieldClocks    Json      @map("field_clocks")
  list           TaskList  @relation(fields: [listId], references: [id])
  attachments    TaskAttachment[]

  @@index([listId, deletedAt, sortKey])
  @@index([parentTaskId])
  @@map("tasks")
}

model TaskAttachment {
  id        String    @id @default(uuid()) @db.Char(36)
  taskId    String    @map("task_id") @db.Char(36)
  fileName  String    @map("file_name") @db.VarChar(255)
  mimeType  String    @map("mime_type") @db.VarChar(100)
  sizeBytes Int       @map("size_bytes")
  storageKey String   @map("storage_key") @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, deletedAt])
  @@map("task_attachments")
}

model EmailVerification {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  email     String    @db.VarChar(320)
  codeHash  String    @map("code_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verifications")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model SyncOperation {
  operationId    String    @id @map("operation_id") @db.Char(36)
  userId         String    @map("user_id") @db.Char(36)
  entityType     String    @map("entity_type") @db.VarChar(40)
  entityId       String    @map("entity_id") @db.Char(36)
  operationType  String    @map("operation_type") @db.VarChar(40)
  payload        Json
  clientTimestamp DateTime @map("client_timestamp")
  createdAt      DateTime  @default(now()) @map("created_at")
  appliedAt      DateTime? @map("applied_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("sync_operations")
}

enum UserStatus {
  PENDING
  ACTIVE
  DELETED
}

enum TaskStatus {
  PENDING
  COMPLETED
}
